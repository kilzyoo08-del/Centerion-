# Centerion Qwen3-4B server
# Point to a directory containing config.json, tokenizer files and all model shards.
CENTERION_MODEL_PATH=/models/centerion_qwen3_4b
# Or omit CENTERION_MODEL_PATH and use the public model ID:
# CENTERION_MODEL_ID=Qwen/Qwen3-4B

# Use the same long random value as Supabase secret CENTERION_KOLAI_TOKEN.
# Never commit a real token.
CENTERION_LOCAL_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Load and validate the model during server startup.
CENTERION_PRELOAD_MODEL=1

# Qwen3-4B should use a suitable GPU host. CPU inference is disabled by default.
CENTERION_ALLOW_CPU_MODEL=0
CENTERION_LOCAL_FILES_ONLY=1

# Optional persistent path for legacy local memory endpoints.
CENTERION_DB_PATH=/data/centerion.sqlite3

# Optional token for legacy Android endpoints (/answer, /files, /code, /memory).
CENTERION_API_TOKEN=
